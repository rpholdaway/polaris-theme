{%- comment -%}
  Hero
  "overlay" mode centers text over a full-bleed image with a color wash.
  "split" mode pairs a half-width image with a solid text panel.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign overline = section.settings.overline
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign b1_text = section.settings.button1_text
  assign b1_url = section.settings.button1_url
  assign b2_text = section.settings.button2_text
  assign b2_url = section.settings.button2_url
  assign layout = section.settings.layout
  assign overlay_opacity = section.settings.overlay_opacity
  assign hero_alt = image.alt | default: heading | escape
-%}

{%- if layout == 'split' -%}
  <section class="md:grid md:grid-cols-2 min-h-[600px] md:min-h-screen">
    <div class="relative overflow-hidden min-h-[300px] md:min-h-0">
      {%- if image != blank -%}
        <picture>
          {%- if image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ image_mobile | image_url: width: 1200 }}">
          {%- endif -%}
          {{ image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 768px) 50vw, 100vw', alt: hero_alt, class: 'absolute inset-0 w-full h-full object-cover' }}
        </picture>
      {%- endif -%}
    </div>

    <div class="bg-sand flex flex-col justify-center px-8 md:px-16 py-16 md:py-20">
      {%- if overline != blank -%}
        <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-slate mb-4">
          {{- overline | escape -}}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h1 class="font-display text-4xl md:text-5xl text-night mb-6">
          {{- heading | escape -}}
        </h1>
      {%- endif -%}

      {%- if subtitle != blank -%}
        <p class="font-body text-lg text-slate mb-10 max-w-xl">
          {{- subtitle | escape -}}
        </p>
      {%- endif -%}

      {%- if b1_text != blank or b2_text != blank -%}
        <div class="flex flex-wrap gap-4">
          {%- if b1_text != blank -%}
            <a
              href="{{ b1_url | default: routes.all_products_collection_url }}"
              class="font-body font-medium bg-forest text-white px-8 py-3 rounded-lg hover:bg-forest/90 transition active:scale-[0.97]"
            >
              {{- b1_text | escape -}}
            </a>
          {%- endif -%}
          {%- if b2_text != blank -%}
            <a
              href="{{ b2_url | default: routes.all_products_collection_url }}"
              class="font-body font-medium border-2 border-night/20 text-night px-8 py-3 rounded-lg hover:border-night/40 transition active:scale-[0.97]"
            >
              {{- b2_text | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  <section
    class="relative min-h-[600px] md:min-h-[85vh] flex items-center"
    style="background-color: {{ section.settings.bg_color }};"
  >
    {%- if image != blank -%}
      <picture>
        {%- if image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ image_mobile | image_url: width: 1200 }}">
        {%- endif -%}
        {{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: hero_alt, class: 'absolute inset-0 w-full h-full object-cover' }}
      </picture>
      <div class="absolute inset-0 bg-forest" style="opacity: {{ overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}

    <div class="relative z-10 flex flex-col justify-center items-center text-center h-full max-w-3xl mx-auto px-4">
      {%- if overline != blank -%}
        <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-sage mb-4">
          {{- overline | escape -}}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h1 class="font-display text-4xl md:text-5xl text-white mb-6">
          {{- heading | escape -}}
        </h1>
      {%- endif -%}

      {%- if subtitle != blank -%}
        <p class="font-body text-lg text-white/80 mb-10 max-w-xl">
          {{- subtitle | escape -}}
        </p>
      {%- endif -%}

      {%- if b1_text != blank or b2_text != blank -%}
        <div class="flex flex-wrap justify-center gap-4">
          {%- if b1_text != blank -%}
            <a
              href="{{ b1_url | default: routes.all_products_collection_url }}"
              class="font-body font-medium bg-earth text-white px-8 py-3 rounded-lg hover:bg-earth/90 transition active:scale-[0.97]"
            >
              {{- b1_text | escape -}}
            </a>
          {%- endif -%}
          {%- if b2_text != blank -%}
            <a
              href="{{ b2_url | default: routes.all_products_collection_url }}"
              class="font-body font-medium border-2 border-white/30 text-white px-8 py-3 rounded-lg hover:border-white/60 transition active:scale-[0.97]"
            >
              {{- b2_text | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Image with text overlay" },
        { "value": "split", "label": "Image left, text right" }
      ],
      "default": "overlay"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Used below 768px; defaults to the background image."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#323C32"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Built for the backcountry"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Release the beast"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Rooftop tents, awnings and recovery gear tested on the worst roads we could find."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button1_text",
      "label": "Primary button label",
      "default": "Shop the range"
    },
    {
      "type": "url",
      "id": "button1_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Secondary button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
