{%- comment -%}
  Collection Product Grid
  Toolbar (sort + filter toggle + count), product grid, active filters,
  pagination, and an empty state.
{%- endcomment -%}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign per_page = section.settings.products_per_page | default: 24
-%}

<section class="w-full px-4 md:px-8 lg:px-16 py-10 md:py-14 bg-snow" data-animate="main-collection">
  <div class="max-w-[1440px] mx-auto">

    <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-stone/30">
      <div class="flex items-center gap-3">
        {%- if section.settings.enable_filtering -%}
          <button
            type="button"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-stone/40 text-night font-body text-sm hover:bg-wheat/40 transition-colors"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="collection-filters"
          >
            {%- render 'icon-svg', name: 'filter' -%}
            <span>{{ 'collections.filters.filter_and_sort' | t: default: 'Filter' }}</span>
          </button>
        {%- endif -%}
        <p class="text-sm text-bark font-body" data-collection-count>
          {{ 'collections.general.items_count' | t: count: collection.products_count, default: collection.products_count | append: ' products' }}
        </p>
      </div>

      <form class="flex items-center gap-2" data-sort-form>
        <label for="CollectionSortBy" class="text-sm text-bark font-body whitespace-nowrap">{{ 'collections.sorting.title' | t: default: 'Sort by' }}</label>
        <select
          id="CollectionSortBy"
          name="sort_by"
          class="rounded-md border border-stone/40 bg-snow text-night text-sm font-body py-2 pl-3 pr-8 focus:outline-none focus:ring-2 focus:ring-moss"
          data-sort-select
        >
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>{{ 'collections.sorting.featured' | t: default: 'Featured' }}</option>
          <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>{{ 'collections.sorting.best_selling' | t: default: 'Best selling' }}</option>
          <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>{{ 'collections.sorting.az' | t: default: 'Alphabetically, A-Z' }}</option>
          <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>{{ 'collections.sorting.za' | t: default: 'Alphabetically, Z-A' }}</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'collections.sorting.price_ascending' | t: default: 'Price, low to high' }}</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'collections.sorting.price_descending' | t: default: 'Price, high to low' }}</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'collections.sorting.newest' | t: default: 'Newest' }}</option>
        </select>
      </form>
    </div>

    {%- if collection.current_vendor or collection.current_type or current_tags -%}
      <div class="flex flex-wrap items-center gap-2 mb-6" data-active-filters>
        {%- for tag in current_tags -%}
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-wheat text-night text-xs font-body">
            {{ tag }}
            <a href="{{ collection.url }}" aria-label="{{ 'collections.filters.remove_tag' | t: default: 'Remove filter' }}" class="text-fire hover:text-fire/70">&times;</a>
          </span>
        {%- endfor -%}
        <a href="{{ collection.url }}" class="text-xs font-body text-bark underline hover:text-fire transition-colors">{{ 'collections.filters.clear_all' | t: default: 'Clear filters' }}</a>
      </div>
    {%- endif -%}

    {%- paginate collection.products by per_page -%}
      {%- if collection.products.size > 0 -%}
        <div
          class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6"
          style="--columns-desktop: {{ columns_desktop }};"
          data-animate-target="product-grid"
        >
          <style>
            @media (min-width: 1024px) {
              [data-animate-target="product-grid"] { grid-template-columns: repeat(var(--columns-desktop), minmax(0, 1fr)); }
            }
          </style>
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product, show_vendor: section.settings.show_vendor -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="flex items-center justify-center gap-2 mt-12" aria-label="{{ 'pagination.label' | t: default: 'Pagination' }}">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="px-4 py-2 rounded-md border border-stone/40 text-sm font-body text-night hover:bg-wheat/40 transition-colors">{{ 'pagination.previous' | t }}</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="px-3 py-2 rounded-md text-sm font-body text-night hover:bg-wheat/40 transition-colors">{{ part.title }}</a>
              {%- else -%}
                <span class="px-3 py-2 rounded-md text-sm font-body bg-forest text-snow">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="px-4 py-2 rounded-md border border-stone/40 text-sm font-body text-night hover:bg-wheat/40 transition-colors">{{ 'pagination.next' | t }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="flex flex-col items-center justify-center text-center py-20" data-animate-target="collection-empty">
          {%- render 'icon-svg', name: 'search' -%}
          <p class="mt-4 font-body text-bark text-base">{{ 'products.no_products' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="mt-4 inline-block px-6 py-3 rounded-md bg-forest text-snow font-body text-sm hover:bg-forest/90 transition-colors">{{ 'general.shop' | t }}</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor on product cards",
      "default": false
    }
  ]
}
{% endschema %}
