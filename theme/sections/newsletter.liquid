

<section class="text-on-forest py-20 md:py-24" style="background-color: {{ section.settings.bg_color }};">
  <div class="max-w-2xl mx-auto px-4 text-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="text-display-md font-display text-white mb-4">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="body-lg text-white/70 mb-10 max-w-lg mx-auto">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    {%- form 'contact', id: 'ContactFormNewsletter', class: 'flex flex-col sm:flex-row gap-3 max-w-md mx-auto' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <label for="ContactFormNewsletter-email" class="sr-only">
        {{ section.settings.placeholder }}
      </label>
      <input
        type="email"
        name="contact[email]"
        id="ContactFormNewsletter-email"
        placeholder="{{ section.settings.placeholder }}"
        required
        class="flex-1 bg-white/10 border border-white/20 rounded-lg px-5 py-3.5 text-white placeholder:text-white/40 text-body-md focus:outline-none focus:border-white/40 transition"
      >

      <button
        type="submit"
        class="bg-earth hover:bg-earth/90 text-white font-medium px-8 py-3.5 rounded-lg transition whitespace-nowrap"
      >
        {{ section.settings.button_text }}
      </button>

      {%- if form.posted_successfully? -%}
        <p class="newsletter__success text-sage mt-4 w-full">
          Thanks for subscribing!
        </p>
      {%- endif -%}

      {%- if form.errors -%}
        <p class="newsletter__error text-earth mt-4 w-full">
          {{ form.errors.messages['email'] | default: 'Please enter a valid email address.' }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sign up for early access, new arrivals, and occasional good news."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#323C32"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
