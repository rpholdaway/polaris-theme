{%- comment -%} sections/gift-card.liquid {%- endcomment -%}
<section class="min-h-screen bg-forest px-4 py-16 flex items-center justify-center" data-section-id="{{ section.id }}" data-section-type="gift-card">
  <div class="max-w-md w-full rounded-2xl bg-snow p-8 md:p-10 text-center" data-gsap="fade-up">
    <p class="font-mono text-xs uppercase tracking-widest text-stone mb-6">{{ shop.name }}</p>

    <div class="relative aspect-[16/10] rounded-lg overflow-hidden bg-night mb-8">
      {%- if section.settings.gift_card_image != blank -%}
        {{ section.settings.gift_card_image | image_url: width: 800 | image_tag: width: 800, height: 500, class: 'w-full h-full object-cover', loading: 'eager' }}
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center">
          <span class="font-display text-2xl uppercase tracking-widest text-snow">{{ 'gift_cards.issued.gift_card' | t }}</span>
        </div>
      {%- endif -%}
    </div>

    <p class="font-body text-sm uppercase tracking-widest text-stone mb-2">{{ 'gift_cards.issued.remaining_html' | t }}</p>
    <p class="font-mono text-4xl md:text-5xl text-night mb-8">{{ gift_card.balance | money_without_trailing_zeros }}</p>

    {%- if gift_card.enabled != true or gift_card.expired -%}
      <p class="font-body text-sm text-fire mb-6">
        {%- if gift_card.expired -%}{{ 'gift_cards.issued.expired' | t }}{%- else -%}{{ 'gift_cards.issued.disabled' | t }}{%- endif -%}
      </p>
    {%- endif -%}

    <div class="rounded-lg border border-stone/30 bg-white p-6 mb-8">
      <p class="font-mono text-lg tracking-[0.2em] text-night mb-4" data-gift-card-code>{{ gift_card.code | format_code }}</p>
      {% comment %} QR code generated by Shopify at runtime {% endcomment %}
{{ gift_card.qr_identifier }}
    </div>

    <div class="flex flex-col gap-3">
      <a href="{{ shop.url }}" class="rounded-md bg-forest px-6 py-3 font-body text-sm font-medium text-snow transition-colors hover:bg-moss">{{ 'gift_cards.issued.shop_link' | t: shop: shop.name }}</a>
      <button type="button" data-copy-code class="rounded-md border border-stone/40 px-6 py-3 font-body text-sm font-medium text-night transition-colors hover:border-forest">{{ 'gift_cards.issued.copy_code' | t }}</button>
      <a href="{{ 'gift_cards.issued.print_url' | t }}" class="font-body text-xs text-bark underline underline-offset-4 hover:text-forest" onclick="window.print(); return false;">{{ 'gift_cards.issued.print' | t }}</a>
    </div>

    <p class="font-mono text-[10px] uppercase tracking-widest text-stone mt-8">{{ 'gift_cards.issued.powered_by_shopify_html' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Gift Card",
  "settings": [
    { "type": "image_picker", "id": "gift_card_image", "label": "Gift card image" }
  ]
}
{% endschema %}
