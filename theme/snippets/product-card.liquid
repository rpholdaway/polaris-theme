{%- comment -%}
  Renders a product card.
  Accepts:
    - product: {Object} product object (required)
    - show_quick_add: {Boolean} show the quick-add-to-cart button (default: true)
    - show_vendor: {Boolean} show the product vendor (default: false)
{%- endcomment -%}

{%- liquid
  assign show_quick_add = show_quick_add | default: true
  assign show_vendor = show_vendor | default: false
  assign card_product_url = product.url
  assign featured_image = product.featured_media.preview_image | default: product.featured_image
-%}

<div class="group relative bg-white rounded-lg overflow-hidden border border-sand hover:shadow-lg transition-shadow duration-300">
  <a href="{{ card_product_url }}" class="block" aria-label="{{ product.title | escape }}">
    <div class="aspect-[3/4] bg-snow relative overflow-hidden">
      {%- if product.available == false -%}
        <span class="bg-slate text-white text-xs px-2 py-0.5 rounded-sm absolute top-3 left-3 z-10">Sold Out</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="bg-earth text-white text-xs px-2 py-0.5 rounded-sm absolute top-3 left-3 z-10">Sale</span>
      {%- endif -%}

      {%- if featured_image -%}
        <img
          src="{{ featured_image | image_url: width: 800 }}"
          alt="{{ featured_image.alt | default: product.title | escape }}"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          width="{{ featured_image.width }}"
          height="{{ featured_image.height }}"
        >
      {%- else -%}
        <div class="absolute inset-0 w-full h-full bg-sand"></div>
      {%- endif -%}
    </div>
  </a>

  {%- if show_quick_add and product.available -%}
    <product-form class="absolute bottom-0 inset-x-0 md:translate-y-full md:group-hover:translate-y-0 transition-transform duration-300">
      <form method="post" action="{{ routes.cart_add_url }}" id="quick-add-{{ product.id }}">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          name="add"
          class="w-full bg-forest text-white text-sm font-medium py-3 text-center hover:bg-forest/90 transition-colors"
        >
          Quick Add
        </button>
      </form>
    </product-form>
  {%- endif -%}

  <div class="px-4 pt-4 pb-5">
    {%- if show_vendor and product.vendor -%}
      <p class="text-xs uppercase tracking-wider text-slate mb-1">{{ product.vendor }}</p>
    {%- endif -%}

    <a href="{{ card_product_url }}" class="block">
      <h3 class="font-body font-semibold text-night text-sm leading-snug mb-1 line-clamp-2">
        {{ product.title }}
      </h3>
    </a>

    <div class="flex items-center gap-2 mt-1">
      <span class="font-body font-bold text-night">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="text-slate line-through text-sm">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
