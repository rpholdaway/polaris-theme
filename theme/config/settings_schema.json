[
  {
    "name": "theme_info",
    "theme_name": "Polaris",
    "theme_version": "1.0.0",
    "theme_author": "Polaris",
    "theme_documentation_url": "https://example.com/polaris/docs",
    "theme_support_url": "https://example.com/polaris/support"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "select",
        "id": "color_preset",
        "label": "Color Preset",
        "options": [
          { "value": "overland", "label": "Overland" },
          { "value": "alpine", "label": "Alpine" },
          { "value": "coastal", "label": "Coastal" }
        ],
        "default": "overland"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary",
        "default": "#323C32"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#B43C32"
      },
      {
        "type": "color",
        "id": "color_bg_light",
        "label": "Light Background",
        "default": "#F7F7F7"
      },
      {
        "type": "color",
        "id": "color_bg_warm",
        "label": "Warm Background",
        "default": "#E7E6DD"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "special_gothic_condensed_one_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "geist_n4"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 150,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_header",
        "label": "Sticky Header",
        "default": true
      }
    ]
  },
  {
    "name": "Features",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Announcement Bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_predictive_search",
        "label": "Predictive Search",
        "default": true
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  }
]
